---
import Section from "@/components/Section.astro";
import { projects } from "@/cv.json";
---

<Section title="Proyectos">
  <ul>
    {
      projects.map(({ url, description, highlights, name, isActive }) => {
        return (
          <li>
            <article>
              <header>
                <h3>
                  <a href={url} title={`ver proyecto ${name}`}>
                    {name}
                  </a>
                  {isActive && <span>&bull;</span>}
                </h3>
                <p>{description}</p>
              </header>
              <footer>
                {highlights.map((highlight) => {
                  return <span>{highlight}</span>;
                })}
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  article {
    border-radius: 18px;
    border: 1px solid #f2f2f2;
    gap: 16px;
    display: flex;
    flex-direction: column;
    padding: 14px;
    height: 100%;
  }

  article header {
    flex: 1;
  }

  article h3 {
    margin-bottom: 4px;
  }

  article a {
    color: #111;
  }

  article a:hover {
    text-decoration: underline;
  }

  article p {
    font-size: 0.75rem;
    line-height: 1.2rem;
    margin-bottom: 4px;
  }

  article h3 span {
    color: rgb(4, 164, 4);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 0.6rem;
  }

footer span {
  border-radius: 6px;
  background: black;   /* Fondo negro */
  color: white;        /* Letra blanca */
  font-size: 0.7rem;
  font-weight: 500;
  padding: 0.2rem 0.6rem;
  border: 1px solid white; /* Borde blanco */
  transition: background-color 0.3s ease, border-color 0.3s ease; /* Transición suave */
}

footer span:hover {
  background: gray;   /* Cambia a fondo blanco en hover */
  color: black;        /* Cambia el color de texto a negro */
  border: 1px solid black; /* Cambia el borde a negro */
}

</style>
